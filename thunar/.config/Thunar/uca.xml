<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>org.wezfurlong.wezterm</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1750443381886523-1</unique-id>
	<command>/usr/bin/wezterm start --cwd %f</command>
	<description>Open wezterm</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>visual-studio-code</icon>
	<name>Open with VSCode</name>
	<submenu></submenu>
	<unique-id>1756847119259418-1</unique-id>
	<command>code %f</command>
	<description>Open in vscode editor</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<other-files/>
	<text-files/>
</action>
<action>
	<icon>edit-copy</icon>
	<name>Copy path</name>
	<submenu></submenu>
	<unique-id>1756908110339840-1</unique-id>
	<command>wl-copy %f</command>
	<description></description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>application-zip</icon>
	<name>Send to zip</name>
	<submenu></submenu>
	<unique-id>1759849670765155-1</unique-id>
	<command>ZIP_NAME=$(zenity --entry --text=&quot;Enter ZIP file name&quot; --entry-text=&quot;archive&quot;) &amp;&amp; zip -r &quot;$ZIP_NAME.zip&quot; %F</command>
	<description>Creates a zip file</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>

</actions>
