{
  "include": ["~/.config/waybar/base-modules.jsonc"],
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "disable-scroll": false,
    "on-click": "activate",
    "all-outputs": false,
    "sort-by-number": true,
    "persistent-workspaces": {
      "DP-3": [1, 3, 5, 7, 9],
      "DP-2": [2, 4, 6, 8, 10],
    },
  },
}
