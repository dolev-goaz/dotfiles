{
    "$schema": "https://opencode.ai/config.json",
    "model": "anthropic/claude-sonnet-4-5",
    "small_model": "anthropic/claude-haiku-4-5",
    "theme": "catppuccin",
    "permission": {
        "bash": {
            "git status": "allow",
            "git diff": "allow",
            "git log*": "allow",
            "git show": "allow",
            "git branch --list": "allow",
            "git ls-files": "allow",
            "git fetch": "allow",
            "*": "ask",
        },
        "read": "deny",
        "grep": "deny",
    },
    "tui": {
        "scroll_speed": 3,
        "scroll_acceleration": {
            "enabled": true,
        },
    },
}
