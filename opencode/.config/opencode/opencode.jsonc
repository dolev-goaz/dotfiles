    "mcp": {
        "stitch": {
            "url": "https://stitch.googleapis.com/mcp",
            "type": "remote",
            "headers": {
                "Accept": "application/json",
                "X-Goog-Api-Key": "",
            },
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--executablePath",
                "/usr/bin/chromium",
                "--headless",
            ],
        },
